# Base mainnet RPC for settle receipt parsing and Basename lookup (server-only).
# Example: https://base-mainnet.g.alchemy.com/v2/your-api-key
RPC_URL=

# Use Base Sepolia (84532) instead of Base mainnet (8453). Default: false.
# NEXT_PUBLIC_TESTNET=true

# Required for real deposits
FACILITATOR_URL=https://x402.org/facilitator
EVM_ADDRESS=0xYourReceiverAddress
NEXT_PUBLIC_RECEIVER_ADDRESS=0xYourReceiverAddress
# Signs claim/refund batches locally; omit to use the facilitator authorizer
EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=0xYourReceiverAuthorizerPrivateKey

# Optional Redis/Valkey storage for x402 channels and leaderboard.
# Omit REDIS_URL to use local file storage under STORAGE_DIR.
# REDIS_URL=redis://localhost:6379
STORAGE_DIR=./storage

# Admin dashboard (/admin) — wallet address allowed to view server stats
ADMIN_WALLET=0xYourAdminWalletAddress

# Cron jobs (/api/cron/claim, /api/cron/settle) — bearer token for GitHub Actions
# CRON_SECRET=your-random-secret

# Dev: skip login and on-chain deposit for gameplay testing
NEXT_DEV=true

# Game economics (also readable on client via NEXT_PUBLIC_*)
# MAX_JUMPS_PER_RUN=100
# RUN_MAX_PRICE=0.01
